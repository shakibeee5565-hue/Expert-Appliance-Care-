<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Expert Appliance Care | এক্সপার্ট অ্যাপ্লায়েন্স কেয়ার</title>
<meta name="description" content="Repair and service for refrigerators, air conditioners, washing machines and TVs in Narayangonj.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Source+Serif+4:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#0B2545;
  --blue:#1D5FD1;
  --silver:#C9D1DB;
  --mist:#F2F5F9;
  --white:#FFFFFF;
  --ink:#13223A;
  --muted:#51607A;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:"Hind Siliguri",system-ui,sans-serif;color:var(--ink);background:var(--white);line-height:1.65;font-size:17px}
h1,h2,h3{font-family:"Source Serif 4","Hind Siliguri",Georgia,serif;line-height:1.2;color:var(--navy)}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}

/* language switching */
[data-lang="bn"] .en,[data-lang="en"] .bn{display:none}

header{position:sticky;top:0;z-index:10;background:var(--white);border-bottom:1px solid var(--silver)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 20px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.brand svg{width:38px;height:38px;flex:none}
.brand b{font-family:"Source Serif 4",serif;font-size:19px;color:var(--navy);line-height:1.1;display:block}
.brand span{font-size:13px;color:var(--muted);letter-spacing:.02em}
nav{display:flex;align-items:center;gap:22px}
nav a{text-decoration:none;font-weight:500;color:var(--muted);font-size:15px}
nav a:hover{color:var(--blue)}
.lang{display:inline-flex;border:1px solid var(--silver);border-radius:999px;overflow:hidden}
.lang button{border:0;background:transparent;padding:6px 14px;font:inherit;font-size:14px;cursor:pointer;color:var(--muted)}
.lang button[aria-pressed="true"]{background:var(--navy);color:var(--white)}

.hero{background:var(--navy);color:var(--white);padding:84px 0 92px;position:relative;overflow:hidden}
.hero h1{color:var(--white);font-size:clamp(34px,6vw,58px);max-width:15em}
.hero p{margin-top:20px;max-width:34em;color:#D5DEEB;font-size:19px}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.btn{display:inline-block;padding:13px 26px;border-radius:6px;font-weight:600;text-decoration:none;font-size:16px}
.btn.primary{background:var(--white);color:var(--navy)}
.btn.primary:hover{background:var(--silver)}
.btn.ghost{border:1.5px solid var(--silver);color:var(--white)}
.btn.ghost:hover{background:rgba(255,255,255,.1)}
.hero .mark{position:absolute;right:-60px;bottom:-70px;width:420px;opacity:.09;pointer-events:none}

section{padding:76px 0}
section h2{font-size:clamp(26px,4vw,36px);margin-bottom:10px}
.lead{color:var(--muted);max-width:36em;margin-bottom:36px}

.services{background:var(--mist)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
.svc{background:var(--white);border:1px solid var(--silver);border-radius:8px;padding:26px}
.svc svg{width:40px;height:40px;stroke:var(--blue);fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;margin-bottom:14px}
.svc h3{font-size:20px;margin-bottom:6px}
.svc p{color:var(--muted);font-size:15.5px}

.why ul{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px}
.why li{display:flex;gap:14px;align-items:flex-start}
.why li svg{flex:none;width:26px;height:26px;margin-top:3px;stroke:var(--blue);fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.why li b{display:block;color:var(--navy)}
.why li span{color:var(--muted);font-size:15.5px}

.contact{background:var(--navy);color:var(--white)}
.contact h2{color:var(--white)}
.contact .lead{color:#D5DEEB}
.rows{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px}
.rows div{border-top:1px solid #35507A;padding-top:14px}
.rows small{display:block;color:#A9B8CF;font-size:14px}
.rows a,.rows p{font-size:19px;font-weight:500;text-decoration:none}
.rows a:hover{text-decoration:underline}

footer{padding:26px 0;font-size:14px;color:var(--muted);border-top:1px solid var(--silver)}

@media (max-width:720px){
  nav a{display:none}
  .hero{padding:56px 0 64px}
  section{padding:54px 0}
  .hero .mark{width:260px}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
